{
  "name": "pz-dp-ua-website",
  "version": "1.0.0",
  "description": "High-converting legal website for ПРАВОВИЙ ЗАХИСТ ДНІПРО - Military law specialists with 87% success rate",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss assets/css/main.css -o dist/main.min.css --use autoprefixer cssnano",
    "build:js": "webpack --mode production",
    "serve": "http-server . -p 8000 -c-1",
    "lint": "eslint assets/js/**/*.js",
    "format": "prettier --write assets/**/*.{js,css,html}"
  },
  "keywords": [
    "legal",
    "military-law",
    "ukraine",
    "vlk-appeal",
    "medical-expertise",
    "lead-generation",
    "conversion-optimization"
  ],
  "author": "ПРАВОВИЙ ЗАХИСТ ДНІПРО",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "sqlite3": "^5.1.6",
    "axios": "^1.4.0",
    "validator": "^13.9.0",
    "dotenv": "^16.1.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "eslint": "^8.42.0",
    "prettier": "^2.8.8",
    "autoprefixer": "^10.4.14",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "webpack": "^5.87.0",
    "webpack-cli": "^5.1.4",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pz.dp.ua.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/pz.dp.ua/issues"
  },
  "homepage": "https://pz.dp.ua"
}